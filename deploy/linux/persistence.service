[Unit]
# Template systemd *user* unit. install.sh renders __VENV__ and __TOKEN__ and
# writes the result to ~/.config/systemd/user/persistence.service.
Description=Persistence MCP memory server
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=__VENV__
Environment=PERSISTENCE_HOST=0.0.0.0
Environment=PERSISTENCE_PORT=8077
Environment=OLLAMA_URL=http://localhost:11434
Environment=PERSISTENCE_TOKEN=__TOKEN__
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
